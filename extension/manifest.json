{
  "manifest_version": 3,
  "name": "Duotrigordle Bot",
  "short_name": "DuoBot",
  "version": "0.3.0",
  "description": "A near-optimal solver for duotrigordle.com — overlays the next guess on every daily and practice game. Runs entirely in your browser.",
  "author": "Shruichan",
  "homepage_url": "https://shruichan.github.io/DuotrigordleBot/",
  "icons": {
    "16":  "icons/icon-16.png",
    "48":  "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://duotrigordle.com/*"],
  "content_scripts": [
    {
      "matches": ["https://duotrigordle.com/*"],
      "js": ["engine.js", "solver.js", "content.js"],
      "css": ["overlay.css"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "data/solutions_default.txt",
        "data/valid_guesses.txt",
        "data/value_net.bin"
      ],
      "matches": ["https://duotrigordle.com/*"]
    }
  ],
  "action": {
    "default_title": "Duotrigordle Bot",
    "default_popup": "popup.html",
    "default_icon": {
      "16":  "icons/icon-16.png",
      "48":  "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
